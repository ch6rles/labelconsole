# Restricted role: row-level security applies to every query.
DATABASE_URL=postgres://labelconsole_app:app_password@127.0.0.1:5432/labelconsole
# Owner role: migrations and narrow cross-tenant system work only.
DATABASE_SYSTEM_URL=postgres://labelconsole_owner:owner_password@127.0.0.1:5432/labelconsole
# Used by `pnpm db:setup` to create roles, database and extensions (local dev / CI).
# On hosts that give you one admin URL (Railway), set only this and SIGNING_SECRET:
# DATABASE_URL and DATABASE_SYSTEM_URL are then derived from it.
DATABASE_SUPERUSER_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
REDIS_URL=redis://127.0.0.1:6379
APP_URL=http://localhost:3000

# openssl rand -base64 32  (wraps per-org data keys in the credentials vault)
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_ID=local-v1
# openssl rand -hex 32  (signed storage URLs, webhook tokens)
SIGNING_SECRET=

# local | s3   (s3 works with AWS S3, Cloudflare R2 or Railway buckets)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # Railway buckets; path-style is the default with a custom endpoint

# The one label this installation runs. There is no public sign-up: the first
# visit to the site sets up this label and its owner account. `pnpm owner`
# adds an owner or resets a forgotten password from the terminal.
LABEL_NAME="River Of Styxx"

# Platform default key for agents and document extraction. A label can add
# its own key under Settings → Integrations, which takes precedence.
ANTHROPIC_API_KEY=
# Only for a personal key that isn't scoped to one workspace: the workspace to bill (wrkspc_…).
ANTHROPIC_WORKSPACE_ID=
# Voyage AI key for semantic agent memory (https://dash.voyageai.com). Labels can add their own.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Optional platform YouTube Data API key (labels can add their own under Settings > Integrations)
YOUTUBE_API_KEY=
# Optional platform SpotScraper key (https://www.spotscraper.com): Spotify play counts, credits, ISRC search.
SPOTSCRAPER_API_KEY=

HTTP_USER_AGENT="LabelConsole/0.1 (+https://labelconsole.app; ops@labelconsole.app)"
LOG_LEVEL=info
# Bearer token for GET /api/metrics (Prometheus). Leave empty to keep the endpoint off.
# openssl rand -hex 24
METRICS_TOKEN=
WORKER_CONCURRENCY=8
WORKER_AGENT_CONCURRENCY=8
AGENT_CONCURRENCY_PER_ORG=4

# Set to 1 to allow `pnpm db:seed` (refused when NODE_ENV=production).
LC_DEV_SEED=
