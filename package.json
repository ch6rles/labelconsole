{
  "name": "labelconsole",
  "private": true,
  "version": "0.1.0",
  "description": "Label Console: a multi-tenant workspace for record labels",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @labelconsole/web --filter @labelconsole/worker dev",
    "dev:web": "pnpm --filter @labelconsole/web dev",
    "dev:worker": "pnpm --filter @labelconsole/worker dev",
    "build": "pnpm --filter @labelconsole/web build && pnpm --filter @labelconsole/worker build",
    "start:web": "pnpm --filter @labelconsole/web start",
    "start:worker": "pnpm --filter @labelconsole/worker start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:load": "LC_LOAD_TEST=1 vitest run --project load",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore-drill": "tsx scripts/restore-drill.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset && tsx scripts/db-migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/papaparse": "^5.3.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@labelconsole/core": "workspace:*",
    "@labelconsole/people": "workspace:*",
    "@labelconsole/drive": "workspace:*",
    "@labelconsole/network": "workspace:*",
    "@labelconsole/catalogue": "workspace:*",
    "@labelconsole/documents": "workspace:*",
    "@labelconsole/streams": "workspace:*",
    "@labelconsole/marketing": "workspace:*",
    "@labelconsole/agents": "workspace:*",
    "@labelconsole/inbox": "workspace:*",
    "@labelconsole/settings": "workspace:*",
    "postgres": "^3.4.9",
    "drizzle-orm": "^0.45.3",
    "zod": "^4.6.5",
    "ioredis": "^5.11.1",
    "@playwright/test": "1.63.0",
    "@types/nodemailer": "^8.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
