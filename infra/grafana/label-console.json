        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (lc_queue_jobs{state=\"waiting\"})",
          "legendFormat": "{{queue}} waiting",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (queue) (lc_queue_jobs{state=\"active\"})",
          "legendFormat": "{{queue}} active",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (queue) (lc_queue_jobs{state=\"delayed\"})",
          "legendFormat": "{{queue}} delayed",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
